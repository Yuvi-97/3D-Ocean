# ==============================================================================
# INCOIS 3D Ocean Visualizer Backend - Environment Configuration
# ==============================================================================

# Centralized Data Source Selection
# Options: "local" (default) or "huggingface"
DATA_SOURCE=huggingface

# ------------------------------------------------------------------------------
# LOCAL Mode Configuration (Active when DATA_SOURCE=local)
# ------------------------------------------------------------------------------
# Path to local ocean-data directory.
# By default, it automatically resolves to the project's "ocean-data/data" folder
# relative to the repository root. Teammates can simply leave this commented out.
# Or provide a relative path: "../ocean-data/data" or "ocean-data/data".
# LOCAL_DATA_ROOT=../ocean-data/data

# Optional granular local path overrides (automatically derived if omitted):
# CMEMS_MODEL_PATH=../ocean-data/data/model/cmems_indian_ocean_2026_06.nc
# ARGO_DATA_DIR=../ocean-data/data/argo
# ARGO_INDEX_CSV=../ocean-data/data/argo/argo_incois_indian_ocean_2026_index.csv
# GLIDER_DATA_DIR=../ocean-data/data/glider
# GLIDER_INDEX_CSV=../ocean-data/data/glider/glider_2026_indian_ocean_index.csv

# ------------------------------------------------------------------------------
# HUGGING FACE Mode Configuration (Active when DATA_SOURCE=huggingface)
# ------------------------------------------------------------------------------
HF_DATASET_REPO=Yuvi2006pro/ocean-data
HF_REVISION=main

# Optional Hugging Face access token (only needed if repository is set to private)
# HF_TOKEN=hf_...

# Optional custom directory for caching Hugging Face downloads
# HF_CACHE_DIR=./.hf_cache

# ------------------------------------------------------------------------------
# Performance & Caching Configuration
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=128
